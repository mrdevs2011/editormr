{
  "buildCommand": "node scripts/build-config.js",
  "outputDirectory": ".",
  "trailingSlash": true,
  "redirects": [
    {
      "source": "/login.html",
      "destination": "/login/",
      "permanent": true
    },
    {
      "source": "/terms.html",
      "destination": "/terms/",
      "permanent": true
    },
    {
      "source": "/privacy.html",
      "destination": "/privacy/",
      "permanent": true
    },
    {
      "source": "/index.html",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/:folder/index.html",
      "destination": "/:folder/",
      "permanent": true
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Cross-Origin-Opener-Policy",
          "value": "same-origin"
        },
        {
          "key": "Cross-Origin-Embedder-Policy",
          "value": "credentialless"
        }
      ]
    }
  ]
}
